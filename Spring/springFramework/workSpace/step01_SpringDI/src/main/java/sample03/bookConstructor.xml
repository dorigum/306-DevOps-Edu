<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean class="sample03.BookDAOImpl" id="bookDao" />

	<!-- 인수 4개를 받는 생성자 호출 -->
	<bean class="sample03.BookVo" id="bookVo">
		<constructor-arg value="Spring DI" />
		<constructor-arg value="Koo" />
		<constructor-arg value="30000" />
		<constructor-arg value="2026-05-07" />
	</bean>

	<bean class="sample03.BookController" id="controller">
		<constructor-arg ref="bookDao" />
		<constructor-arg ref="bookVo" />
	</bean>

</beans>
